{
  "name": "xarkgg",
  "private": true,
  "description": "Portfolio site for Manass Kusko (Xark). Static, no build step.",
  "scripts": {
    "vendor": "mkdir -p vendor/ios-kit && cp node_modules/@kitlangton/ios-kit/ios-kit.js node_modules/@kitlangton/ios-kit/ios-kit.css node_modules/@kitlangton/ios-kit/LICENSE vendor/ios-kit/",
    "build:preloader": "node scripts/build-preloader.mjs",
    "postinstall": "npm run vendor"
  },
  "dependencies": {
    "@kitlangton/ios-kit": "github:kitlangton/ios-kit",
    "@tsparticles/engine": "3.9.1",
    "@tsparticles/react": "3.0.0",
    "@tsparticles/slim": "3.9.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "postcss": "8.5.32",
    "tailwindcss": "4.3.4",
    "typescript": "5.9.3"
  }
}
